{
  "name": "eventflow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/scripts/bootstrapDb.js && nodemon --watch src --ext js,json --delay 300ms src/server.js",
    "start": "node src/scripts/bootstrapDb.js && node src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:migrate": "node src/scripts/migrateDb.js",
    "db:seed-admin": "node src/scripts/seedAdmin.js",
    "db:bootstrap": "node src/scripts/bootstrapDb.js",
    "test:e2e:business": "node src/scripts/e2eBusinessTest.js",
    "test:e2e:security": "node src/scripts/e2eSecurityTest.js",
    "test:e2e:load": "node src/scripts/e2eLoadTest.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
