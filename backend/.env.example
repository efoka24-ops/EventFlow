PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventflow
# Set to true when your managed Postgres requires TLS.
DB_SSL=false
# Set to false only in development when your provider/proxy uses a self-signed cert chain.
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=change_me_please
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@eventflow.local
ADMIN_PASSWORD=change_admin_password
ADMIN_FULL_NAME=EventFlow Admin

# CamPay
CAMPAY_BASE_URL=https://demo.campay.net/api
# Option 1: temporary token credentials
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Option 2: permanent access token
CAMPAY_PERMANENT_TOKEN=
