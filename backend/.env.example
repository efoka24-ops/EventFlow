PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventflow
# Set to true when your managed Postgres requires TLS.
DB_SSL=false
# Set to false only in development when your provider/proxy uses a self-signed cert chain.
DB_SSL_REJECT_UNAUTHORIZED=true

# OBLIGATOIRE en production — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=change_me_please
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=30

CORS_ORIGIN=http://localhost:5173

# Compte admin par défaut (utilisé uniquement si la table admin_accounts est vide)
# OBLIGATOIRE en production
ADMIN_EMAIL=admin@eventflow.local
ADMIN_PASSWORD=change_admin_password_min_12_chars
ADMIN_FULL_NAME=EventFlow Admin

# CamPay
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_PERMANENT_TOKEN=

# Easy Transact
ET_BASE_URL=https://api.easy-transact.net
ET_CLIENT_ID=
ET_CLIENT_SECRET=
ET_DEMO_MODE=false
# Secret partagé pour vérifier les signatures des webhooks (X-ET-Signature header)
# Configurer la même valeur dans votre tableau de bord Easy Transact
ET_WEBHOOK_SECRET=

# Email SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=NoReply EventFlow
