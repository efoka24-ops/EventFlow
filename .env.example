# Deployment environment for docker-compose and GitHub Actions
# This file is a template only. Do not commit real secrets in .env.
# In production, set these values on the server .env or in the GitHub secret DEPLOY_ENV_FILE_B64.

EVENTFLOW_TAG=latest
GITHUB_REPOSITORY_OWNER=efoka24-ops

# Backend runtime
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://eventflow.trugroup.cm
JWT_SECRET=change_me_please
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@eventflow.com
ADMIN_PASSWORD=change_admin_password
ADMIN_FULL_NAME=Administrator

# Database
# Use your live DATABASE_URL when you want production to match local current values.
# If DATABASE_URL is omitted, docker-compose falls back to the local eventflow-db container below.
DATABASE_URL=postgresql://postgres:postgres@db-host:5432/eventflow?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow_pass
POSTGRES_DB=eventflow_db

# CamPay
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_PERMANENT_TOKEN=

# Easy Transact
ET_BASE_URL=https://api.easy-transact.net
ET_CLIENT_ID=
ET_CLIENT_SECRET=
ET_DEMO_MODE=false

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=NoReply EventFlow
